    {
      "parameters": {
        "jsCode": "const body = $('Webhook').item.json.body;\nconst mensaje = body.mensaje;\nconst resultados = $('Busca cursos similares Qdrant').item.json.result || [];\nconst cursos = resultados\n  .filter((resultado) => resultado.score >= 0.35 && resultado.payload?.estado === 'activo')\n  .map((resultado) => ({ ...resultado.payload, similitud: resultado.score }));\n\nreturn [{\n  json: {\n    hasResults: cursos.length > 0,\n    model: \"openai/gpt-4o-mini\",\n    messages: [\n      {\n        role: \"system\",\n        content: \"Eres un asistente de orientación académica. Responde usando exclusivamente los cursos activos del contexto. No inventes cursos ni datos. Si el contexto no contiene información suficiente para responder, indícalo claramente y no recomiendes cursos.\"\n      },\n      {\n        role: \"user\",\n        content: `Perfil del estudiante: nivel ${body.nivelExperiencia || 'no indicado'}, área de interés ${body.areaInteres || 'no indicada'}.\\n\\nContexto de cursos recuperados:\\n${JSON.stringify(cursos, null, 2)}\\n\\nPregunta del estudiante: ${mensaje}`\n      }\n    ]\n  }\n}];"
      },
