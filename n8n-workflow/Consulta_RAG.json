    {
      "parameters": {
        "jsCode": "const respuesta = $('Generador de Respuesta').item.json.choices?.[0]?.message?.content?.trim() || 'No se generó respuesta.';\nconst resultados = $('Busca cursos similares Qdrant').item.json.result || [];\nconst fuentes = resultados\n  .filter((resultado) => resultado.score >= 0.35 && resultado.payload?.estado === 'activo')\n  .map((resultado) => ({\n    id: resultado.payload.mongo_id,\n    nombre: resultado.payload.nombre,\n    descripcion: resultado.payload.descripcion,\n    categoria: resultado.payload.categoria,\n    nivel: resultado.payload.nivel,\n    duracion: resultado.payload.duracion,\n    similitud: resultado.score\n  }));\n\nreturn [{\n  json: {\n    respuesta,\n    fuentes,\n    estado: fuentes.length ? 'Respondida' : 'Sin resultados'\n  }\n}];"
      },
