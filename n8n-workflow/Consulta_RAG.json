      "parameters": {
        "jsCode": "const items = $input.all();\nfor (const item of items) {\n  const embedding = item.json.data?.[0]?.embedding;\n  if (!Array.isArray(embedding) || embedding.length !== 1536 || !embedding.every((value) => typeof value === 'number' && Number.isFinite(value))) {\n    throw new Error('OpenRouter devolvió un embedding inválido para la consulta.');\n  }\n}\nreturn items;"
      },
